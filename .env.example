# This project has two independent Android apps.
# Use the flavor-specific template instead of mixing CN and English settings:
#
#   cp .env.cn.example .env      # 财富记账本
#   cp .env.intl.example .env    # AI Wealth Tracker
#
# Release/CI builds should prefer --dart-define or secret storage.

# Android release signing for Huawei/AppGallery builds.
# Prefer android/key.properties for local builds, or set these in CI secret storage:
#
#   AI_ACCOUNTANT_ANDROID_KEYSTORE_FILE=/absolute/path/to/upload-keystore.jks
#   AI_ACCOUNTANT_ANDROID_STORE_PASSWORD=...
#   AI_ACCOUNTANT_ANDROID_KEY_ALIAS=...
#   AI_ACCOUNTANT_ANDROID_KEY_PASSWORD=...
#
# Local alternative, ignored by git:
#
#   android/key.properties
#   storeFile=/absolute/path/to/upload-keystore.jks
#   storePassword=...
#   keyAlias=...
#   keyPassword=...
