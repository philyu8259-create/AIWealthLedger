<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Conservative Android auto-backup policy:
         exclude secure storage shared-preference files to avoid encrypted-key backup coupling issues. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="flutter_secure_storage" />
    <exclude domain="sharedpref" path="flutter_secure_storage.xml" />
</full-backup-content>
