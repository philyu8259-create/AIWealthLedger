# AI Wealth Tracker (English) environment template
# The English app only configures international services; do not put CN AI/OCR/ASR keys here.

# --- English AI / OCR / US stocks ---
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
FINNHUB_API_KEY=

# --- English sign-in ---
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_REVERSED_CLIENT_ID=
# Optional documentation/helper value for Google Cloud's Android OAuth client.
# Android runtime sign-in uses GOOGLE_SERVER_CLIENT_ID as the required web client id.
GOOGLE_ANDROID_CLIENT_ID=

# --- Cloud API ---
ALIYUN_FC_API=
